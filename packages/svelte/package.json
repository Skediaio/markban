{
  "name": "@markban/svelte",
  "version": "0.1.0",
  "private": true,
  "description": "A Svelte 5 component that renders a markban board, and a Vite plugin that loads boards at build time with sanitised card HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Skediaio/markban",
    "directory": "packages/svelte"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "svelte": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./vite": "./src/vite.js",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "style.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@markban/core": "0.1.0",
    "remark-gfm": "4.0.1",
    "remark-markban": "0.1.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/svelte": "5.4.2",
    "happy-dom": "21.0.4",
    "svelte": "5.57.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
